<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="25dp">

    <ImageView
        android:id="@+id/img_umbrella"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:src="@drawable/outline_add_home_24"
        app:layout_constraintBottom_toTopOf="@id/edittext_username"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
    </ImageView>

    <TextView
        android:id="@+id/text_view_info_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Informações de Login"
        app:layout_constraintBottom_toTopOf="@id/edittext_username"
        app:layout_constraintLeft_toLeftOf="parent"
        android:textSize="20dp"
        android:textStyle="bold"
        android:layout_marginBottom="5dp">
    </TextView>

    <EditText
        android:id="@+id/edittext_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/design_default_color_on_primary"
        android:drawableLeft="@drawable/outline_add_home_work_24"
        android:padding="5dp"
        android:drawablePadding="5dp"
        android:text="Nome do usuário"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
    </EditText>

    <EditText
        android:id="@+id/edittext_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="5dp"
        android:layout_marginTop="10dp"
        android:padding="5dp"
        android:text="Senha"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edittext_username">
    </EditText>

    <Button
        android:id="@+id/button_join"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Entrar"
        android:textSize="18dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/black"
        app:layout_constraintTop_toBottomOf="@id/edittext_password"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
    </Button>

    <TextView
        android:id="@+id/text_recover_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Esqueci minha senha"
        app:layout_constraintTop_toBottomOf="@id/button_join"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
    </TextView>

    <TextView
        android:id="@+id/textivew_acesso_codigo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Acesso por código"
        app:layout_constraintTop_toBottomOf="@+id/text_recover_password"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="10dp"
        android:textSize="18dp"
        android:textStyle="bold">
    </TextView>

    <EditText
        android:id="@+id/edittext_codigo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="5dp"
        android:layout_marginTop="5dp"
        android:textColor="@color/white"
        android:background="@color/design_default_color_on_secondary"
        android:text="Código"
        app:layout_constraintTop_toBottomOf="@id/textivew_acesso_codigo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/enviar">
    </EditText>

    <Button
        android:id="@+id/enviar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cornerRadius="0dp"
        android:backgroundTint="@color/black"
        app:layout_constraintLeft_toRightOf="@id/edittext_codigo"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textivew_acesso_codigo"
        android:text="Enviar">
    </Button>

    <Button
        android:id="@+id/button_entrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Entrar"
        android:textSize="18dp"
        android:layout_marginTop="20dp"
        app:cornerRadius="0dp"
        android:backgroundTint="@color/black"
        app:layout_constraintTop_toBottomOf="@id/edittext_password"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
    </Button>

    <TextView
        android:id="@+id/text_alternative_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ou faça login com"
        android:layout_marginTop="10dp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/edittext_codigo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        >
    </TextView>

    <ImageButton
        android:id="@+id/imgbutton_left"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="fitCenter"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/text_alternative_login"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@id/imgbutton_mid">
    </ImageButton>

    <ImageButton
        android:id="@+id/imgbutton_mid"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/text_alternative_login"
        app:layout_constraintLeft_toLeftOf="@id/imgbutton_left"
        app:layout_constraintRight_toRightOf="@id/imgbutton_right">
    </ImageButton>

    <ImageButton
        android:id="@+id/imgbutton_right"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/text_alternative_login"
        app:layout_constraintLeft_toLeftOf="@id/imgbutton_mid"
        app:layout_constraintRight_toRightOf="parent">
    </ImageButton>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Não tem conta?"
        android:textColorHint="@color/black"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/clique_aqui">
    </TextView>

    <TextView
        android:id="@+id/clique_aqui"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ou clique aqui para se cadastrar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
    </TextView>
</androidx.constraintlayout.widget.ConstraintLayout>