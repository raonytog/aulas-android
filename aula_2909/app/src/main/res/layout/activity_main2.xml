<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:paddingBottom="50dp"
    android:paddingTop="50dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2">

    <ImageView
        android:id="@+id/img_apple"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/blue"
        android:src="@drawable/apple_svgrepo_com"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/img_pizza"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/img_pizza"
        android:background="@color/blue"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:src="@drawable/pizza_svgrepo_com"
        app:layout_constraintLeft_toRightOf="@id/img_apple"
        app:layout_constraintRight_toLeftOf="@id/img_icecream"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/img_icecream"
        android:background="@color/blue"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:src="@drawable/food_ice_svgrepo_com"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toRightOf="@id/img_pizza"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/button_back"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        android:src="@drawable/outline_arrow_left_alt_24"
        app:layout_constraintHorizontal_bias="0.20"
        app:layout_constraintTop_toBottomOf="@id/img_pizza"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/text_greating"/>

    <TextView
        android:id="@+id/text_greating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="30dp"
        android:textSize="20dp"
        app:layout_constraintTop_toBottomOf="@id/img_pizza"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:text="@string/view2_greating"/>

    <TextView
        android:id="@+id/text_random_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:paddingLeft="50dp"
        android:paddingRight="50dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="@string/view2_random_phrase"/>

    <Button
        android:id="@+id/button_gerar_frase"
        android:backgroundTint="@color/blue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="20dp"
        android:text="@string/view2_gerar_frase"
        app:cornerRadius="10dp"
        android:layout_marginBottom="70dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>



</androidx.constraintlayout.widget.ConstraintLayout>