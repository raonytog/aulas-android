<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="60dp"
    tools:context=".UI.InformationsActivity">

    <!-- navbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constrain_navbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/navbar_bg"
        android:paddingHorizontal="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/img_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/outline_arrow_back_24"
            app:tint="@color/bg_app_light"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="30dp"
            android:src="@mipmap/ic_launcher_round"
            app:layout_constraintStart_toEndOf="@id/img_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/text_beside_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:text="@string/app_name"
            android:textSize="30sp"
            android:textColor="@color/bg_app_light"
            app:layout_constraintStart_toEndOf="@id/img_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- view da bandeira -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constrain_banner"
        android:layout_margin="10dp"
        android:background="@color/navbar_bg"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/constrain_navbar">

        <ImageView
            android:id="@+id/img_flag"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginStart="25dp"
            android:src="@drawable/baseline_backpack_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/text_state"
            style="@style/sub_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:text="@string/state"
            android:textColor="@color/bg_app_light"
            android:textSize="15sp"
            app:layout_constraintBottom_toTopOf="@id/text_state_name"
            app:layout_constraintStart_toEndOf="@id/img_flag"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_state_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_name"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textAllCaps="false"
            style="@style/main_text"
            app:layout_constraintStart_toEndOf="@id/img_flag"
            app:layout_constraintTop_toBottomOf="@id/text_state"
            app:layout_constraintBottom_toTopOf="@id/state_abrev"/>

        <TextView
            android:id="@+id/state_abrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_abrev"
            android:textSize="20sp"
            style="@style/main_text"
            app:layout_constraintStart_toEndOf="@id/img_flag"
            app:layout_constraintTop_toBottomOf="@id/text_state_name"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constrain_address"
        android:layout_margin="10dp"
        android:background="@color/navbar_bg"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/constrain_banner">
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constrain_adicional"
        android:layout_margin="10dp"
        android:background="@color/navbar_bg"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/constrain_address">
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>