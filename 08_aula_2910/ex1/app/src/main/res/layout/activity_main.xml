<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="40dp"
    android:paddingTop="50dp"
    tools:context=".view.ui.MainActivity">

    <LinearLayout
        android:id="@+id/linear_navbar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/light_purple"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/img_add"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:src="@drawable/add"
            android:layout_marginEnd="40dp"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/img_list"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:src="@drawable/list"
            android:layout_marginStart="40dp"
            app:tint="@color/white"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <EditText
            android:id="@+id/edit_anima_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/light_purple"
            android:hint="@string/type_animal_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linear_navbar"/>

        <Button
            android:id="@+id/button_add_animal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_animal"/>
    </LinearLayout>





</androidx.constraintlayout.widget.ConstraintLayout>