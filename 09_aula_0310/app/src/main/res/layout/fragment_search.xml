<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".view.fragments.FragmentSearch">


    <TextView
        android:id="@+id/text_curiosidade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="16sp"
        android:textStyle="italic"
        android:text="@string/who_is_that_pokemon"
        app:layout_constraintBottom_toTopOf="@id/img_pikachu"/>

    <ImageView
        android:id="@+id/img_pikachu"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/pokemon_pikachu"
        app:tint="@color/red_200"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/edit_pokemon_name"/>


    <EditText
        android:id="@+id/edit_pokemon_name"
        android:layout_width="200sp"
        android:layout_height="50sp"
        android:inputType="text"
        android:hint="@string/edit_pokemon_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/button_find_pokemon"
        android:layout_width="200sp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/red_100"
        android:text="@string/button_find_pokemon"
        app:layout_constraintTop_toBottomOf="@id/edit_pokemon_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>